# Copy to .env for local work. Real values are never committed: server-side
# secrets are set in Project Settings → Secrets, and only ever read on the server.

# --- Server-side only (never expose to the browser) ---
# Anthropic API key used for AI project generation.
ANTHROPIC_API_KEY=
# Which Claude model to use. Falls back to claude-sonnet-5-5 when unset.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Database connection and the key that may read saved projects server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Key used for public, read-only database lookups from server code.
SUPABASE_PUBLISHABLE_KEY=

# --- Browser-visible (safe to commit) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Generation limits (server-side, optional; defaults shown)
VISITOR_GENERATIONS_LIMIT=3
VISITOR_GENERATIONS_WINDOW_SECONDS=900
GLOBAL_GENERATIONS_PER_MINUTE=60
GLOBAL_GENERATIONS_PER_DAY=500
# 0 = no daily token ceiling
DAILY_TOKEN_LIMIT=0
MAX_OUTPUT_TOKENS_PER_GENERATION=4096
# Optional salt for hashing anonymous visitor ids
VISITOR_HASH_SALT=
# Optional private endpoint for consented counsellor-call requests.
COUNSELLOR_WEBHOOK_URL=
